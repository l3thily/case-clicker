[Unit]
Description=Case Clicker cloud saves and leaderboard
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/case-clicker/server.py
Environment=PORT=8093
DynamicUser=yes
StateDirectory=case-clicker
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
